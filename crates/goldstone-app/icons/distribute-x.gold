# Goldstone editor icon, drawn on a 24 x 24 pt canvas (origin bottom left).
# Rendered by Goldstone itself; black and white are re-tinted for the theme.
format = 1
# Distribute centers horizontally

[[shape]]
kind = "box"
at = [4.5, 12]
size = [4, 10]
fill = "#3584e4"
width = 1

[[shape]]
kind = "box"
at = [12, 12]
size = [4, 16]
fill = "#a8c8f0"
width = 1

[[shape]]
kind = "box"
at = [19.5, 12]
size = [4, 7]
fill = "#3584e4"
width = 1

[[vertex]]
id = "p1"
at = [4.5, 2]

[[vertex]]
id = "p2"
at = [19.5, 2]

[[edge]]
from = "p1"
to = "p2"
width = 1
arrow = "forward"
arrow_pos = 0.88
arrow_length = 4
arrow_width = 4
