# Goldstone editor icon, drawn on a 24 x 24 pt canvas (origin bottom left).
# Rendered by Goldstone itself; black and white are re-tinted for the theme.
format = 1
# Rotate counterclockwise: a 270 degree arc (bend -135)

[[shape]]
kind = "box"
at = [12, 12]
size = [6, 6]
fill = "#3584e4"
width = 1

[[vertex]]
id = "p1"
at = [12, 19.5]

[[vertex]]
id = "p2"
at = [19.5, 12]

[[edge]]
from = "p1"
to = "p2"
bend = -135
width = 1.6
arrow = "forward"
arrow_pos = 0.94
arrow_length = 6
arrow_width = 6
