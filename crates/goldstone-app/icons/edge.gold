# Goldstone editor icon, drawn on a 24 x 24 pt canvas (origin bottom left).
# Rendered by Goldstone itself; black and white are re-tinted for the theme.
format = 1
# Edge tool: a line with an arrow between two vertices

[[vertex]]
id = "p1"
at = [4, 5]
kind = "dot"
size = 4

[[vertex]]
id = "p2"
at = [20, 19]
kind = "dot"
size = 4

[[edge]]
from = "p1"
to = "p2"
arrow = "forward"
width = 1.5
arrow_length = 7
arrow_width = 6
