# Goldstone editor icon, drawn on a 24 x 24 pt canvas (origin bottom left).
# Rendered by Goldstone itself; black and white are re-tinted for the theme.
format = 1
# Vertex tool: a three-line interaction vertex

[[vertex]]
id = "p1"
at = [12, 11]
kind = "dot"
size = 7

[[vertex]]
id = "p2"
at = [3, 3]

[[edge]]
from = "p1"
to = "p2"
width = 1.5

[[vertex]]
id = "p3"
at = [21, 3]

[[edge]]
from = "p1"
to = "p3"
width = 1.5

[[vertex]]
id = "p4"
at = [12, 22]

[[edge]]
from = "p1"
to = "p4"
width = 1.5
