# Goldstone editor icon, drawn on a 24 x 24 pt canvas (origin bottom left).
# Rendered by Goldstone itself; black and white are re-tinted for the theme.
format = 1
# Align top edges

[[shape]]
kind = "box"
at = [8, 13]
size = [5, 12]
fill = "#3584e4"
width = 1

[[shape]]
kind = "box"
at = [16, 15]
size = [5, 8]
fill = "#a8c8f0"
width = 1

[[vertex]]
id = "p1"
at = [2, 20]

[[vertex]]
id = "p2"
at = [22, 20]

[[edge]]
from = "p1"
to = "p2"
width = 1.6
layer = 1
